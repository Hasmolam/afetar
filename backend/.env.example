# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration
# PostgreSQL connection string format:
# postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/afetar_db

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# CORS Configuration
# Virgülle ayrılmış frontend URL'leri
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006

# Email Configuration (Optional - SMS/Email bildirimleri için)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password

# Redis Configuration (Optional - Caching/Real-time için)
REDIS_URL=redis://localhost:6379/0

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# SMS Configuration (Optional - Telefon doğrulama için)
# SMS_API_KEY=your-sms-api-key
# SMS_API_SECRET=your-sms-api-secret

# Push Notification Configuration (Optional)
# FIREBASE_SERVER_KEY=your-firebase-server-key

# API Keys (Harita servisi için)
# MAPBOX_API_KEY=your-mapbox-api-key
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Application Settings
PORT=5000
DEBUG=True
